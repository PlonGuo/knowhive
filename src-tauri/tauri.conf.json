{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KnowHive",
  "version": "0.1.0",
  "identifier": "com.plonguo.knowhive",
  "build": {
    "frontendDist": "../dist-web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun run build:web && bun run build:sidecar"
  },
  "app": {
    "windows": [
      {
        "title": "KnowHive",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/bun"],
    "resources": ["resources/server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
